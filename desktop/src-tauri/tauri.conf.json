{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PowerAudio",
  "version": "0.1.0",
  "identifier": "com.7ph.poweraudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PowerAudio",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "Benjamin Raymond",
    "shortDescription": "Real-time audio visualizer for Windows",
    "longDescription": "A beautiful real-time audio visualizer that reacts to any sound playing on your system. Features smooth 60fps animations with an animated character, orbiting particles, and dynamic waveforms.",
    "copyright": "Copyright (c) 2024 Benjamin Raymond",
    "category": "Entertainment",
    "windows": {
      "certificateThumbprint": null,
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
